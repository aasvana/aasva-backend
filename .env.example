# ===== App =====
PORT=3000
NODE_ENV=development
API_PREFIX=api

# CORS: comma-separated list of allowed origins (e.g. http://localhost:5173)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=aasvaDB
# DATABASE_URL='postgresql://neondb_owner:npg_QCx9PLfIok2W@ep-billowing-moon-axjuffl9-pooler.c-4.us-east-2.aws.neon.tech/aasva_db?sslmode=require&channel_binding=require'


# ===== JWT =====
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Mail (SMTP) =====
# Leave SMTP_HOST empty to log emails to the console (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Public base URL used to build links inside emails (e.g. password reset link).
APP_BASE_URL=http://localhost:3000

# ===== Google OAuth =====
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3300/api/auth/google/callback

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3000

# ===== Bootstrap admin (used by `npm run seed`) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ===== ImageKit (logo uploads) =====
# https://imagekit.io — dashboard → Developer Options. Leave EMPTY to store
# logo data URLs directly in the DB instead of uploading to ImageKit.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ===== AI tagline enhancement (Gemini free tier) =====
# Get a free API key at https://aistudio.google.com/apikey. Leave GEMINI_API_KEY
# empty to disable the "Enhance with AI" feature.
# gemini-2.0-flash has been retired by Google (returns 404). If the configured
# model is missing or overloaded, the service automatically falls back to
# gemini-3.8-flash and then gemini-2.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
